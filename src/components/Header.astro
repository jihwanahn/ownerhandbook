---
import { NAV, SITE } from '../data/site';
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap header-bar">
    <a class="brand" href="/">
      <img src="/favicon.svg" alt="" width="34" height="34" />
      <span>{SITE.name}</span>
    </a>
    <p class="header-tagline">{SITE.tagline}</p>
    <nav class="site-nav" aria-label="Categories">
      <ul>
        <li><a href="/articles/" aria-current={path === '/articles/' ? 'page' : undefined}>All Guides</a></li>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
